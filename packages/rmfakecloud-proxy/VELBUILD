maintainer="Mitchell Scott <mitchell@scottlabs.io>"
pkgname=rmfakecloud-proxy
pkgver=0.0.11
pkgrel=2
pkgdesc="HTTPS proxy for rmfakecloud - redirects reMarkable cloud traffic"
upstream_author="ddvk"
category="utilities"
url="https://github.com/ddvk/rmfakecloud-proxy"
arch="aarch64 armv7"
license="MIT"
readmeurl="https://raw.githubusercontent.com/$upstream_author/rmfakecloud-proxy/v$pkgver/README.md"

source="
	"https://github.com/ddvk/rmfakecloud-proxy/archive/v$pkgver.zip"
	rmfakecloudctl
	rmfakecloud-proxy.service
"


image(){
	echo eeems/vellum-toolchain:6.0.112-$CARCH
}

build() {
	cd "$srcdir/$pkgname-$pkgver"
	eval "$(go env)"
	cat > version.go << GO
package main
const Version = "rmfakecloud-proxy ${_upver%-*} ($GOOS-$GOARCH) $GOVERSION\n$_url"
GO
	GOARCH=arm GOARM=7 go build -ldflags="-w -s" -o "$srcdir"/rmfakecloud-proxy
}

package() {
	install -Dm755 "$srcdir/rmfakecloudctl" \
		"$pkgdir/home/root/.vellum/bin/rmfakecloudctl"
	install -Dm755 "$srcdir"/rmfakecloud-proxy \
		"$pkgdir/home/root/.vellum/bin/rmfakecloud-proxy"
	install -Dm644 "$srcdir/rmfakecloud-proxy.service" \
		"$pkgdir/home/root/.vellum/share/rmfakecloud-proxy/rmfakecloud-proxy.service"
}

postinstall() {
	set -e
	/home/root/.vellum/bin/mount-rw
	postosupgrade
	/home/root/.vellum/bin/mount-restore
}

postupgrade() {
	set -e
	postinstall
}

postosupgrade() {
	set -e
	bash -ec '
	source /home/root/.vellum/bin/rmfakecloudctl
	install-service
	if systemctl is-enabled -q rmfakecloud-proxy.service; then
		install-certificates
		systemctl enable --now rmfakecloud-proxy
		install-hosts
	else
		uninstall-certificates
		systemctl disable rmfakecloud-proxy.service
		uninstall-hosts
	fi
	'
	/home/root/.vellum/bin/rmfakecloudctl status
	cat <<'EOF'

═══════════════════════════════════════════════════════
              rmfakecloud-proxy installed
═══════════════════════════════════════════════════════

  To complete setup, run:
    rmfakecloudctl set-upstream <url>
    rmfakecloudctl enable

  To check the current status run:
    rmfakecloudctl status
EOF
}

predeinstall() {
	/home/root/.vellum/bin/rmfakecloudctl disable
}

