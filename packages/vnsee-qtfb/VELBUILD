maintainer="Interloper <45214659+0xdeb7ef@users.noreply.github.com>"
pkgname=vnsee-qtfb
pkgver=1.1.1
pkgrel=0
upstream_author="asivery"
category="apps"
pkgdesc="VNC client for the reMarkable tablet allowing you to use the device as a second screen"
url="https://github.com/asivery/vnsee"
license="GPL-3.0"
arch="aarch64 armv7"
depends="!rmppure launcher"
replaces="vnsee-qtfb-rm1 vnsee-qtfb-rm2 vnsee-qtfb-rmpp vnsee-qtfb-rmppm"
_commit="704af75bb5f053f052683d2db8d5ddfe4f50a7d2"
readmeurl="https://raw.githubusercontent.com/$upstream_author/vnsee/$_commit/README.md"

source="
https://raw.githubusercontent.com/$upstream_author/vnsee/$_commit/LICENSE.md
"
options='strip'

prepare() {
	default_prepare
	mkdir -p "$srcdir/vnsee-$_commit"
	cd "$srcdir/vnsee-$_commit"
	git config set --global advice.defaultBranchName false
	git init
	git remote add origin https://github.com/asivery/vnsee.git
	git fetch --depth 1 origin $_commit
	git checkout $_commit
	git submodule update --init --recursive
}

image() {
	case "$CARCH" in
	aarch64) echo "eeems/remarkable-toolchain:5.6.75-rmpp" ;;
	armv7) echo "eeems/remarkable-toolchain:5.6.75-rm1" ;;
	*)
		echo "Invalid CARCH: $CARCH"
		exit 1
		;;
	esac
}

build() {
	set -e

	cd "$srcdir"/vnsee-"$_commit"
	. "$(find /opt/codex -name 'environment-setup-*' -type f | head -n1)"
	case "$CARCH" in
	aarch64) arch=arm64 ;;
	armv7) arch=armv7h ;;
	*)
		echo "Invalid CARCH: $CARCH"
		exit 1
		;;
	esac

	mkdir build
	cd build

	PATH="${OECORE_NATIVE_SYSROOT}/usr/libexec:$PATH" \
		cmake -S .. -B . -DCMAKE_BUILD_TYPE=Release

	PATH="${OECORE_NATIVE_SYSROOT}/usr/libexec:$PATH" \
		cmake --build .

	chmod +x dist/vnsee/vnsee
}

package() {
	install -d "$pkgdir"/home/root/xovi/exthome/appload

	for n in "" -0 -1 -2 -3; do
		cp -r "$srcdir"/vnsee-"$_commit"/build/dist/vnsee$n \
			"$pkgdir"/home/root/xovi/exthome/appload/vnsee$n
	done

	install -Dm644 "$srcdir"/LICENSE.md \
		"$pkgdir"/home/root/.vellum/licenses/$pkgname/LICENSE
	echo "https://github.com/asivery/vnsee/archive/$_commit.tar.gz" > \
		"$pkgdir"/home/root/.vellum/licenses/$pkgname/SOURCES
}

postinstall() {
	cat <<'EOF'
======================================================
  NOTE: You have to update your connection parameters
        in
  ~/xovi/exthome/appload/vnsee-*/external.manifest.json
        Where * is the different vnsee display modes.
======================================================
EOF
}

postupgrade() {
	postinstall
}

postdeinstall() {
	if [ "$VELLUM_PURGE" = "1" ]; then
		rm -rf \
			/home/root/xovi/exthome/appload/vnsee \
			/home/root/xovi/exthome/appload/vnsee-0 \
			/home/root/xovi/exthome/appload/vnsee-1 \
			/home/root/xovi/exthome/appload/vnsee-2 \
			/home/root/xovi/exthome/appload/vnsee-3
	fi
}

