maintainer="Ampleforth <213837259+Ampleforth@users.noreply.github.com>"
pkgname=nextcloud-calendar
pkgver=0.1.9
pkgrel=1
upstream_author="Ampleforth"
category="apps"
pkgdesc="Nextcloud calendar and tasks for reMarkable 2"
url="https://github.com/Ampleforth/remarkable2-nextcloudCalendar"
arch="armv7"
license="GPL-3.0-only"
depends="appload>=0.5.3"
readmeurl="https://raw.githubusercontent.com/$upstream_author/remarkable2-nextcloudCalendar/v$pkgver/README.md"
source="$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz"
builddir="$srcdir/remarkable2-nextcloudCalendar-$pkgver"
image="ghcr.io/toltec-dev/golang:v4.0"

build() {
	apt-get update
	apt-get install -y --no-install-recommends qt6-base-dev librsvg2-bin

	cd "$builddir"
	GOFLAGS=-mod=vendor GOTOOLCHAIN=auto RCC=/usr/lib/qt6/libexec/rcc \
		./scripts/build.sh
}

package() {
	cd "$builddir/dist/nextcloud-calendar"
	local dest="$pkgdir/home/root/xovi/exthome/appload/nextcloud-calendar"
	install -Dm755 backend/entry "$dest/backend/entry"
	install -Dm644 manifest.json "$dest"/manifest.json
	install -Dm644 resources.rcc "$dest"/resources.rcc
	install -Dm644 icon.png "$dest"/icon.png
	local notices="$pkgdir/home/root/.vellum/licenses/$pkgname"
	install -Dm644 LICENSE.upstream.md "$notices"/LICENSE.upstream.md
	install -Dm644 THIRD_PARTY_NOTICES.md "$notices"/THIRD_PARTY_NOTICES.md
	local file
	for file in licenses/*; do
		install -Dm644 "$file" "$notices/licenses/${file##*/}"
	done
}

