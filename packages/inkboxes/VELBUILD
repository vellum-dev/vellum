# VELBUILD for inkboxes — a Vellum package (github.com/vellum-dev/vellum, packages/inkboxes/).
# Format: Alpine APKBUILD dialect via Eeems/vbuild. reManager installs from the merged
# Vellum registry, so this VELBUILD (once PR'd + merged) is what puts inkboxes in reManager.
#
# BEFORE SUBMITTING, fill the placeholders marked <...>:
#   - upstream_author  : your GitHub username (lint-enforced)
#   - url / source     : your public inkboxes repo + release tag
#   - license          : the SPDX id you choose (see PUBLISHING.md)
#   - sha512sums       : generated by `./scripts/update-checksums.sh inkboxes` (never hand-write)
#
# inkboxes ships TWO prebuilt artifacts (Vellum CI has no reMarkable Qt SDK, so it cannot
# compile the .so — it is built out-of-band with the tatsu Qt6 SDK, see native/bridge/README.md
# and attached to a GitHub release, exactly like appload/qt-resource-rebuilder ship their .so):
#   - inkboxes-bridge.so  -> /home/root/xovi/extensions.d/            (native xovi extension)
#   - inkboxes-native.qmd -> /home/root/xovi/exthome/qt-resource-rebuilder/   (qmldiff patch)

maintainer="Zane Milakovic <zane.milakovic@icloud.com>"
pkgname=inkboxes
pkgver=1.1.0
pkgrel=0
upstream_author="khrome83"
category="ui"
pkgdesc="Lasso handwriting into a native, tappable TODO checklist with jump-back links"
url="https://github.com/khrome83/inkboxes"
arch="aarch64"
license="GPL-3.0-only"

# qt-resource-rebuilder transitively pulls xovi. Pinned to the tested firmware (xochitl
# 3.27.3): the .qmd patches version-specific QML resource paths, so it must not install on
# other OS builds. inkboxes is Paper Pure (Tatsu) ONLY.
#
# arch=aarch64 alone is NOT a device pin: it excludes the armv7 rM1/rM2, but Paper Pro (rmpp)
# and Paper Pro Move (rmppm) are ALSO aarch64 — the tatsu .so + 3.27.3-Pure .qmd would wrongly
# resolve on them. Positively pin Paper Pure by excluding every other device virtual, the
# ecosystem idiom (Vellum README "Virtual Packages"; cf. rmppm's own package which uses
# `!rm1 !rm2 !rmpp !rmppure`). Excluding rm1/rm2/rmpp/rmppm leaves only rmppure.
depends="qt-resource-rebuilder remarkable-os>=3.27 remarkable-os<3.28 !rm1 !rm2 !rmpp !rmppm"

_rel="v$pkgver"
readmeurl="https://raw.githubusercontent.com/$upstream_author/inkboxes/$_rel/README.md"
source="
https://github.com/$upstream_author/inkboxes/releases/download/$_rel/inkboxes-bridge.so
https://github.com/$upstream_author/inkboxes/releases/download/$_rel/inkboxes-native.qmd
https://raw.githubusercontent.com/$upstream_author/inkboxes/$_rel/LICENSE
"
options="!check !fhs"

package() {
    install -Dm644 "$srcdir"/inkboxes-bridge.so \
        "$pkgdir"/home/root/xovi/extensions.d/inkboxes-bridge.so
    install -Dm644 "$srcdir"/inkboxes-native.qmd \
        "$pkgdir"/home/root/xovi/exthome/qt-resource-rebuilder/inkboxes-native.qmd
    install -Dm644 "$srcdir"/LICENSE \
        "$pkgdir"/home/root/.vellum/licenses/$pkgname/LICENSE
    echo "$url" > "$pkgdir"/home/root/.vellum/licenses/$pkgname/SOURCES
}

# Reload xovi so the new extension + patch take effect (the deploy dance from
# tools/spike/deploy_qmd.sh). Guarded to avoid xochitl's restart-rate reboot.
postinstall() {
    systemctl reset-failed xochitl 2>/dev/null || true
    if [ -x /home/root/xovi/xovi.sh ]; then
        /home/root/xovi/xovi.sh stop 2>/dev/null; /home/root/xovi/xovi.sh start 2>/dev/null
    else
        systemctl restart xochitl 2>/dev/null || true
    fi
    cat <<'EOF'
inkboxes installed. In any notebook, lasso handwriting and tap "Create Todo" — your TODO
notebook is created automatically the first time, and each todo links back to its source.
EOF
}
postupgrade() { postinstall; }

# An OS update rewrites xochitl's QML, staling qt-resource-rebuilder's hashtable.
postosupgrade() {
    echo "After a reMarkable OS update, run  /home/root/xovi/rebuild_hashtable  and restart xochitl."
}

# apk auto-removes both tracked files; just bring xochitl back up WITHOUT the mod.
# IMPORTANT: do NOT delete any config on purge — inkboxes's state lives in the [inkboxes] group
# INSIDE xochitl.conf (QtQuick Settings), so removing a file would destroy xochitl settings.
postdeinstall() {
    systemctl reset-failed xochitl 2>/dev/null || true
    systemctl restart xochitl 2>/dev/null || true
}

