maintainer="mr_marco <marco_meier2210@hotmail.com>"
pkgname=reader-browser
pkgver=0.1.0
pkgrel=0
upstream_author="method-marco"
category="apps"
pkgdesc="Distraction-free reader-mode web browser"
url="https://github.com/$upstream_author/rm-browser"
arch="aarch64"
license="MIT"
depends="appload librarian remarkable-os>=3.29 remarkable-os<3.30"
readmeurl="https://raw.githubusercontent.com/$upstream_author/rm-browser/v$pkgver/README.md"

source="
$pkgname-$pkgver.tar.gz::https://github.com/$upstream_author/rm-browser/archive/refs/tags/v$pkgver.tar.gz
"
builddir="$srcdir/rm-browser-$pkgver"

image() {
	echo "eeems/vellum-toolchain:6.0.112-$CARCH"
}

build() {
	cd "$builddir"/backend
	GOTOOLCHAIN=auto GOOS=linux GOARCH=arm64 CGO_ENABLED=0 go build \
		-buildvcs=false -trimpath -ldflags="-s -w -X main.version=$pkgver" \
		-o "$builddir"/build/backend/entry .

	cd "$builddir"/app
	/usr/lib/qt6/libexec/rcc --binary \
		-o "$builddir"/build/resources.rcc browser.qrc
}

package() {
	_appdir="$pkgdir"/home/root/xovi/exthome/appload/rm-browser
	_licdir="$pkgdir"/home/root/.vellum/licenses/$pkgname

	install -Dm755 build/backend/entry "$_appdir"/backend/entry
	install -Dm644 build/resources.rcc "$_appdir"/resources.rcc
	install -Dm644 app/browser/manifest.json "$_appdir"/manifest.json
	install -Dm644 app/browser/icon.png "$_appdir"/icon.png

	install -Dm644 backend/fonts/OFL-AtkinsonHyperlegible.txt "$_licdir"/OFL-AtkinsonHyperlegible.txt
	install -Dm644 backend/fonts/OFL-Bitter.txt "$_licdir"/OFL-Bitter.txt
	install -Dm644 backend/fonts/OFL-CrimsonPro.txt "$_licdir"/OFL-CrimsonPro.txt
	install -Dm644 backend/fonts/OFL-EBGaramond.txt "$_licdir"/OFL-EBGaramond.txt
	install -Dm644 backend/fonts/OFL-IBMPlexMono.txt "$_licdir"/OFL-IBMPlexMono.txt
	install -Dm644 backend/fonts/OFL-IBMPlexSans.txt "$_licdir"/OFL-IBMPlexSans.txt
	install -Dm644 backend/fonts/OFL-Inter.txt "$_licdir"/OFL-Inter.txt
	install -Dm644 backend/fonts/OFL-Literata.txt "$_licdir"/OFL-Literata.txt
	install -Dm644 backend/fonts/OFL-Lora.txt "$_licdir"/OFL-Lora.txt
	install -Dm644 backend/fonts/OFL-Merriweather.txt "$_licdir"/OFL-Merriweather.txt
	install -Dm644 backend/fonts/OFL-NotoSans.txt "$_licdir"/OFL-NotoSans.txt
	install -Dm644 backend/fonts/OFL-SourceSerif4.txt "$_licdir"/OFL-SourceSerif4.txt
}

postdeinstall() {
	if [ "$VELLUM_PURGE" = "1" ]; then
		rm -rf \
			/home/root/.config/rm-browser \
			/home/root/.cache/rm-browser \
			/home/root/.cache/rm-browser-jail
	fi
}

