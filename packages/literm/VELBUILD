maintainer="Mitchell Scott <mitchell@scottlabs.io>"
pkgname=literm
pkgver=0.1.7
pkgrel=0
upstream_author="asivery"
category="apps"
pkgdesc="A terminal emulator using QtQuick."
url="https://github.com/asivery/rm-literm"
arch="aarch64 armv7"
license="GPL-2.0"
depends="qt-resource-rebuilder remarkable-os>=3.28 remarkable-os<3.29"
readmeurl="https://raw.githubusercontent.com/$upstream_author/rm-literm/v$pkgver/README.md"
donateurl="https://ko-fi.com/asivery"

source="
https://github.com/$upstream_author/rm-literm/releases/download/v$pkgver/literm-aarch64.so
https://github.com/$upstream_author/rm-literm/releases/download/v$pkgver/literm-arm32.so
https://raw.githubusercontent.com/$upstream_author/rm-literm/v$pkgver/COPYING
"

package() {
	local so_file

	case "$CARCH" in
	aarch64) so_file="literm-aarch64.so" ;;
	armv7) so_file="literm-arm32.so" ;;
	esac

	install -Dm644 "$srcdir"/$so_file \
		"$pkgdir"/home/root/xovi/extensions.d/$pkgname.so

	install -d "$pkgdir"/home/root/.config/$pkgname

	install -Dm644 "$srcdir"/COPYING \
		"$pkgdir"/home/root/.vellum/licenses/$pkgname/COPYING
	echo "https://github.com/asivery/rm-literm/archive/v$pkgver.tar.gz" > \
		"$pkgdir"/home/root/.vellum/licenses/$pkgname/SOURCES
}

postdeinstall() {
	if [ "$VELLUM_PURGE" = "1" ]; then
		rm -rf /home/root/.config/literm
	fi
}

