options="strip tracedeps"

package() {
	install -Dm644 "$srcdir"/randomSleepScreen.qmd \
		"$pkgdir"/home/root/xovi/exthome/qt-resource-rebuilder/randomSleepScreen.qmd

	install -dm755 "$pkgdir"/home/root/sleepScreens

	install -Dm644 "$srcdir"/LICENSE.md \
		"$pkgdir"/home/root/.vellum/licenses/$pkgname/LICENSE
	echo "https://github.com/ingatellent/xovi-qmd-extensions" > \
		"$pkgdir"/home/root/.vellum/licenses/$pkgname/SOURCES
}
