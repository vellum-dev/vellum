maintainer="Eeems <eeems@eeems.email>"
pkgname=plato
pkgver=0.9.44
pkgrel=0
upstream_author="LinusCDE"
category="utilities"
pkgdesc="Document reader"
url="https://github.com/$upstream_author/plato"
arch="armv7 aarch64"
license="AGPL-3.0-or-later"
depends="launcher"

source="
https://github.com/LinusCDE/plato/archive/refs/tags/${pkgver%-*}-rm-release-14.zip
external.manifest.aarch64.json
external.manifest.armv7.json
"

image="ghcr.io/toltec-dev/rust:v4.0"

build() {
    set -e
    case "$CARCH" in
    aarch64) . /opt/x-tools/switch-aarch64.sh ;;
    armv7) . /opt/x-tools/switch-arm.sh ;;
    *)
        echo "Invalid CARCH: $CARCH"
        exit 1
        ;;
    esac
    apt-get update
    apt-get install -y \
        jq \
        patchelf \
        unzip \
        wget
    cd "$srcdir"/"$pkgname"-"$pkgver"-rm-release-14
    sed -i "s/version=.*$/version=\'$(cargo pkgid -p plato | cut -d "#" -f 2 | cut -d ":" -f 2)\'/g" download.sh
    sed -i "s/cross build/cargo build/g" build.sh
    ./clean.sh
    ./build.sh
    ./dist.sh
}

package() {
    cd "$srcdir"/"$pkgname"-"$pkgver"-rm-release-14
    local platodir=/home/root/xovi/exthome/appload/plato
    local mediadir=/home/root/plato-media
    install -d "$pkgdir$platodir"
    cp -r ./dist/. "$pkgdir$platodir"
    rmdir "$pkgdir$platodir"/media
    ln -s "$mediadir" "$pkgdir$platodir"/media
    install -d "$pkgdir"/home/root/.vellum/etc
    ln -s /home/root/.vellum/etc/plato.toml "$pkgdir$platodir"/Settings.toml
    install -Dm644 "LICENSE-AGPLv3" \
        "$pkgdir/home/root/.vellum/licenses/$pkgname/LICENSE"
    echo "https://github.com/$upstream_author/plato" > \
        "$pkgdir"/home/root/.vellum/licenses/$pkgname/SOURCES
    install -Dm644 \
        "$startdir"/external.manifest."$CARCH".json \
        "$pkgdir$platodir"/external.manifest.json
}
postinstall() {
    local mediadir=/home/root/plato-media
    if [ ! -d "$mediadir" ]; then
        mkdir "$mediadir"
        echo ""
        echo "Place your media files for plato in '$mediadir'"
        echo ""
    fi

}
postupgrade() {
    postinstall
}
