source="
https://github.com/$upstream_author/koreader/releases/download/v$pkgver/koreader-remarkable-aarch64-v$pkgver.zip
https://github.com/$upstream_author/koreader/releases/download/v$pkgver/koreader-remarkable-v$pkgver.zip
https://raw.githubusercontent.com/$upstream_author/koreader/v$pkgver/COPYING
KOReader.oxide
"

unpack() {
	case "$CARCH" in
	aarch64) unzip -o "$srcdir"/koreader-remarkable-aarch64-v$pkgver.zip -d "$srcdir" ;;
	armv7) unzip -o "$srcdir"/koreader-remarkable-v$pkgver.zip -d "$srcdir" ;;
	esac
}

package() {
	install -d "$pkgdir"/home/root/xovi/exthome/appload
	install -d "$pkgdir"/home/root/.local/share/applications
	cp -r "$srcdir"/koreader \
		"$pkgdir"/home/root/xovi/exthome/appload
	install -Dm644 "$startdir"/KOReader.oxide \
		"$pkgdir"/home/root/.local/share/applications/KOReader.oxide

	sed -i 's/hasOTAUpdates = yes/hasOTAUpdates = no/' \
		"$pkgdir"/home/root/xovi/exthome/appload/koreader/frontend/device/remarkable/device.lua

	install -Dm644 "$srcdir"/COPYING \
		"$pkgdir"/home/root/.vellum/licenses/$pkgname/COPYING
	echo "https://github.com/koreader/koreader/archive/v$pkgver.tar.gz" > \
		"$pkgdir"/home/root/.vellum/licenses/$pkgname/SOURCES
}

postdeinstall() {
	if [ "$VELLUM_PURGE" = "1" ]; then
		rm -rf /home/root/xovi/exthome/appload/koreader
	fi
}

