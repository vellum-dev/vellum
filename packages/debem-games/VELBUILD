maintainer="Rafael de Bem <rafael.bem@debem.dev>"
pkgname=debem-games
pkgver=0.1.2
pkgrel=0
upstream_author="debemtech"
category="apps"
pkgdesc="Chess, Sudoku, Mahjong, Blackjack, Solitaire, and Crossword"
url="https://github.com/$upstream_author/remarkable-games"
arch="aarch64 armv7"
license="GPL-3.0-only"
depends="
appload
debem-chess
debem-sudoku
debem-mahjong
debem-blackjack
debem-solitaire
debem-crossword
"
readmeurl="https://raw.githubusercontent.com/$upstream_author/remarkable-games/v$pkgver/README.md"

subpackages="
debem-chess:_chess
debem-sudoku:_sudoku
debem-mahjong:_mahjong
debem-blackjack:_blackjack
debem-solitaire:_solitaire
debem-crossword:_crossword
"

_stockfish=sf_19
_net=nn-1a298aa575a0.nnue
source="
remarkable-games-$pkgver.tar.gz::https://github.com/$upstream_author/remarkable-games/archive/refs/tags/v$pkgver.tar.gz
Stockfish-$_stockfish.tar.gz::https://github.com/official-stockfish/Stockfish/archive/refs/tags/$_stockfish.tar.gz
$_net::https://tests.stockfishchess.org/api/nn/$_net
"
builddir="$srcdir/remarkable-games-$pkgver"
options="strip"

image() {
	case "$CARCH" in
	aarch64) echo "eeems/remarkable-toolchain:5.6.75-rmpp" ;;
	armv7) echo "eeems/remarkable-toolchain:5.6.75-rm1" ;;
	*)
		echo "Invalid CARCH: $CARCH"
		exit 1
		;;
	esac
}

build() {
	set -e
	apt-get update
	apt-get install -y golang-go
	. "$(find /opt/codex -name 'environment-setup-*' -type f | head -n1)"
	case "$CARCH" in
	aarch64)
		_device=rmpp
		_sfarch=armv8
		;;
	armv7)
		_device=rm2
		_sfarch=armv7-neon
		;;
	*)
		echo "Invalid CARCH: $CARCH"
		exit 1
		;;
	esac

	cd "$srcdir/Stockfish-$_stockfish/src"
	cp "$srcdir/$_net" .
	sed -i '/LDFLAGS += -latomic/d' Makefile
	make -j"$(nproc)" build ARCH="$_sfarch" COMP=gcc CXX="$CXX"

	cd "$builddir"
	for game in chess sudoku mahjong blackjack solitaire crossword; do
		RCC="$OECORE_NATIVE_SYSROOT/usr/libexec/rcc" \
		STOCKFISH_BIN="$srcdir/Stockfish-$_stockfish/src/stockfish" \
		GOTOOLCHAIN=local \
			./build.sh "$game" "$_device"
		mv "build/$game-$_device" "build/$game"
	done
}

package() {
	install -Dm644 "$builddir"/LICENSE \
		"$pkgdir"/home/root/.vellum/licenses/$pkgname/LICENSE
	echo "$url" > "$pkgdir"/home/root/.vellum/licenses/$pkgname/SOURCES
}

_chess() {
	pkgdesc="Chess against Stockfish or a friend, with save slots and a PGN viewer"
	depends="appload"
	package() {
		install -d "$subpkgdir"/home/root/xovi/exthome/appload
		cp -r "$builddir"/build/chess "$subpkgdir"/home/root/xovi/exthome/appload/chess
		install -Dm644 "$builddir"/LICENSE \
			"$subpkgdir"/home/root/.vellum/licenses/$subpkgname/LICENSE
		install -Dm644 "$srcdir/Stockfish-$_stockfish/Copying.txt" \
			"$subpkgdir"/home/root/.vellum/licenses/$subpkgname/LICENSE.stockfish
		echo "$url" > "$subpkgdir"/home/root/.vellum/licenses/$subpkgname/SOURCES
		echo "https://github.com/official-stockfish/Stockfish" >> \
			"$subpkgdir"/home/root/.vellum/licenses/$subpkgname/SOURCES
	}
	postdeinstall() {
		if [ "$VELLUM_PURGE" = "1" ]; then
			rm -rf /home/root/.config/chess
		fi
	}
}

