pkgname=fourcolour
pkgver=1.5.2
pkgrel=0
upstream_author="nickgeenfield"
category="apps"
pkgdesc="Colour comic reader (CBZ/CBR) for the reMarkable Paper Pro"
url="https://github.com/nickgeenfield/FourColour"
arch="aarch64"
license="MIT"
depends="appload"
readmeurl="https://raw.githubusercontent.com/$upstream_author/FourColour/v$pkgver/README.md"

source="
https://github.com/$upstream_author/FourColour/releases/download/v$pkgver/fourcolour-$pkgver-appload.tar.gz
https://raw.githubusercontent.com/$upstream_author/FourColour/v$pkgver/LICENSE
"

package() {
	install -Dm644 "$srcdir"/rm-comics/manifest.json \
		"$pkgdir"/home/root/xovi/exthome/appload/rm-comics/manifest.json
	install -Dm644 "$srcdir"/rm-comics/resources.rcc \
		"$pkgdir"/home/root/xovi/exthome/appload/rm-comics/resources.rcc
	install -Dm644 "$srcdir"/rm-comics/icon.png \
		"$pkgdir"/home/root/xovi/exthome/appload/rm-comics/icon.png
	install -Dm755 "$srcdir"/rm-comics/backend/entry \
		"$pkgdir"/home/root/xovi/exthome/appload/rm-comics/backend/entry

	install -Dm644 "$srcdir"/LICENSE \
		"$pkgdir"/home/root/.vellum/licenses/$pkgname/LICENSE
	echo "https://github.com/nickgeenfield/FourColour/archive/v$pkgver.tar.gz" > \
		"$pkgdir"/home/root/.vellum/licenses/$pkgname/SOURCES
}

postinstall() {
	mkdir -p /home/root/comics
}

postupgrade() {
	postinstall
}

postdeinstall() {
	if [ "$VELLUM_PURGE" = "1" ]; then
		rm -rf /home/root/.local/share/rm-comics
	fi
}

