maintainer="Mitchell Scott <mitchell@scottlabs.io>"
pkgname=fix-ligature-text
pkgver=0.1.0
pkgrel=0
upstream_author="rmitchellscott"
category="fixes"
pkgdesc="Fix the text behind ligatures in generated PDFs so selecting, searching and exporting keeps every letter."
url="https://github.com/rmitchellscott/rm-fix-ligature-text"
arch="aarch64 armv7"
license="GPL-3.0-only"
depends="xovi remarkable-os>=3.28 remarkable-os<3.29"
_xovi_ver="0.3.3"
_commit="d2a7a9cda340ee79c599b331cdeb194cfd10304d"
readmeurl="https://raw.githubusercontent.com/$upstream_author/rm-fix-ligature-text/$_commit/README.md"
changelogurl="https://raw.githubusercontent.com/$upstream_author/rm-fix-ligature-text/$_commit/CHANGELOG.md"
donateurl="https://buymeacoffee.com/rmitchellscott"
source="
rm-fix-ligature-text-$pkgver.tar.gz::https://github.com/$upstream_author/rm-fix-ligature-text/archive/refs/tags/v$pkgver.tar.gz
xovi-$_xovi_ver.tar.gz::https://github.com/asivery/xovi/archive/refs/tags/v$_xovi_ver.tar.gz
"
builddir="$srcdir/rm-fix-ligature-text-$pkgver"

image() {
	case "$CARCH" in
	aarch64) echo "eeems/remarkable-toolchain:5.8.203-aarch64" ;;
	armv7) echo "eeems/remarkable-toolchain:5.8.203-armv7" ;;
	*)
		echo "Invalid CARCH: $CARCH"
		exit 1
		;;
	esac
}

build() {
	set -e
	cd "$builddir"
	case "$CARCH" in
	aarch64)
		. "$(find /opt/codex/chiappa -name 'environment-setup-*' -type f | head -n1)"
		make fix-ligature-text-aarch64.so \
			CXX_AARCH64="$CXX" \
			XOVI_REPO="$srcdir/xovi-$_xovi_ver" \
			VERSION="v$pkgver"
		;;
	armv7)
		. "$(find /opt/codex/rm1 -name 'environment-setup-*' -type f | head -n1)"
		make fix-ligature-text-armv7.so \
			CXX_ARMV7="$CXX" \
			XOVI_REPO="$srcdir/xovi-$_xovi_ver" \
			VERSION="v$pkgver"
		;;
	esac
}

package() {
	install -Dm644 "$builddir"/fix-ligature-text-$CARCH.so \
		"$pkgdir"/home/root/xovi/extensions.d/fix-ligature-text.so

	install -Dm644 "$builddir"/LICENSE \
		"$pkgdir"/home/root/.vellum/licenses/$pkgname/LICENSE
	echo "https://github.com/rmitchellscott/rm-fix-ligature-text/archive/refs/tags/v$pkgver.tar.gz" > \
		"$pkgdir"/home/root/.vellum/licenses/$pkgname/SOURCES
}
