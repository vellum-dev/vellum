maintainer="esclee <5288860+esclee@users.noreply.github.com>"
pkgname=remarkdown
pkgver=0.3.0
pkgrel=0
upstream_author="esclee"
category="apps"
pkgdesc="A lightweight Markdown editor for the reMarkable tablet, to be used via AppLoad"
url="https://github.com/$upstream_author/reMarkdown"
arch="aarch64 armv7"
license="MIT"
depends="appload>=0.5.1"
readmeurl="https://raw.githubusercontent.com/$upstream_author/reMarkdown/v$pkgver/README.md"

source="
reMarkdown-$pkgver.tar.gz::https://github.com/$upstream_author/reMarkdown/archive/refs/tags/v$pkgver.tar.gz
"

image() {
	case "$CARCH" in
	aarch64) echo "eeems/remarkable-toolchain:5.6.75-rmpp" ;;
	armv7) echo "eeems/remarkable-toolchain:5.6.75-rm1" ;;
	*)
		echo "Invalid CARCH: $CARCH"
		exit 1
		;;
	esac
}

build() {
	set -e
	apt-get update
	apt-get install -y golang-go

	cd "$srcdir"/reMarkdown-"$pkgver"
	. "$(find /opt/codex -name 'environment-setup-*' -type f | head -n1)"
	case "$CARCH" in
	aarch64) arch=arm64 ;;
	armv7) arch=armv7h ;;
	*)
		echo "Invalid CARCH: $CARCH"
		exit 1
		;;
	esac
	PATH="${OECORE_NATIVE_SYSROOT}/usr/libexec:$PATH" \
		bash -e ./build.sh "$arch"
	"$STRIP" --strip-unneeded rmd/backend/entry
}

package() {
	cd "$srcdir"/reMarkdown-"$pkgver"
	install -d "$pkgdir"/home/root/xovi/exthome/appload
	cp -r rmd "$pkgdir"/home/root/xovi/exthome/appload
	install -Dm644 LICENSE "$pkgdir"/home/root/.vellum/licenses/$pkgname/COPYING
	echo "https://github.com/esclee/reMarkdown" > \
		"$pkgdir"/home/root/.vellum/licenses/$pkgname/SOURCES
}

postdeinstall() {
	if [ "$VELLUM_PURGE" = "1" ]; then
		rm -rf /home/root/xovi/exthome/appload/rmd
	fi
}
