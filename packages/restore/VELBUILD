maintainer="Ampleforth <213837259+Ampleforth@users.noreply.github.com>"
pkgname=restore
pkgver=0.1.1
pkgrel=0
upstream_author="Ampleforth"
category="apps"
pkgdesc="Native Anna's Archive search and EPUB/PDF downloads"
url="https://github.com/Ampleforth/reStore"
arch="aarch64 armv7"
license="GPL-3.0-only"
depends="appload>=0.5.3"
readmeurl="https://raw.githubusercontent.com/$upstream_author/reStore/v$pkgver/README.md"
source="$pkgname-$pkgver.tar.gz::$url/releases/download/v$pkgver/reStore-$pkgver-source.tar.gz"
builddir="$srcdir/reStore-$pkgver"
image="ghcr.io/toltec-dev/golang:v4.0"

build() {
	apt-get update
	apt-get install -y --no-install-recommends qt6-base-dev librsvg2-bin python3 python3-bs4 libarchive-tools
	cd "$builddir"
	GOFLAGS=-mod=vendor GOTOOLCHAIN=auto RCC=/usr/lib/qt6/libexec/rcc \
		RESTORE_ARCH="$CARCH" RESTORE_ARCHIVE=0 ./scripts/build.sh
}

package() {
	install -Dm755 "$builddir/dist/$CARCH/archive-books/backend/entry" \
		"$pkgdir/home/root/xovi/exthome/appload/archive-books/backend/entry"
	install -Dm644 "$builddir/dist/$CARCH/archive-books/manifest.json" \
		"$pkgdir/home/root/xovi/exthome/appload/archive-books/manifest.json"
	install -Dm644 "$builddir/dist/$CARCH/archive-books/resources.rcc" \
		"$pkgdir/home/root/xovi/exthome/appload/archive-books/resources.rcc"
	install -Dm644 "$builddir/dist/$CARCH/archive-books/icon.png" \
		"$pkgdir/home/root/xovi/exthome/appload/archive-books/icon.png"
	install -Dm644 "$builddir/dist/$CARCH/archive-books/README.md" \
		"$pkgdir/home/root/xovi/exthome/appload/archive-books/README.md"
	mkdir -p "$pkgdir/home/root/xovi/exthome/appload/archive-books/runtime"
	cp -a "$builddir/dist/$CARCH/archive-books/runtime/." \
		"$pkgdir/home/root/xovi/exthome/appload/archive-books/runtime/"
	install -Dm644 "$builddir/dist/$CARCH/archive-books/LICENSE" \
		"$pkgdir/home/root/.vellum/licenses/$pkgname/LICENSE"
	install -Dm644 "$builddir/dist/$CARCH/archive-books/LICENSE.upstream.md" \
		"$pkgdir/home/root/.vellum/licenses/$pkgname/LICENSE.upstream.md"
	install -Dm644 "$builddir/dist/$CARCH/archive-books/THIRD_PARTY_NOTICES.md" \
		"$pkgdir/home/root/.vellum/licenses/$pkgname/THIRD_PARTY_NOTICES.md"
	install -Dm644 "$builddir/dist/$CARCH/archive-books/licenses/LICENSE-DejaVu.txt" \
		"$pkgdir/home/root/.vellum/licenses/$pkgname/licenses/LICENSE-DejaVu.txt"
	install -Dm644 "$builddir/dist/$CARCH/archive-books/licenses/LICENSE-Noto.txt" \
		"$pkgdir/home/root/.vellum/licenses/$pkgname/licenses/LICENSE-Noto.txt"
	install -Dm644 "$builddir/dist/$CARCH/archive-books/licenses/Go-BSD-3-Clause.txt" \
		"$pkgdir/home/root/.vellum/licenses/$pkgname/licenses/Go-BSD-3-Clause.txt"
	echo "https://github.com/$upstream_author/reStore" > \
		"$pkgdir/home/root/.vellum/licenses/$pkgname/SOURCES"
}

